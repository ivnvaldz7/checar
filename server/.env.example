# Proveedor predeterminado recomendado: Groq. Su Browser Search aporta la
# evidencia web usada en las verificaciones. Nunca subas claves a Git.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Protección de la cuota gratuita: análisis por IP cada 15 minutos.
MAX_ANALYSES_PER_15_MIN=10
# Impide agotar la cuota abriendo varias sesiones al mismo tiempo.
MAX_CONCURRENT_ANALYSES_PER_IP=1
MAX_PENDING_PIPELINES=50
# Alternativa opcional, si ya contás con acceso de Gemini:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# Lista separada por comas. Acepta orígenes exactos y comodines de subdominio.
# En Render: CLIENT_URL=https://checar-v2.vercel.app,https://*.vercel.app
CLIENT_URL=http://localhost:5173
